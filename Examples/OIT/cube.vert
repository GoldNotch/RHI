#version 450// Per-instance attribute - the full model matrix (4 vec4s)layout (location = 0) in vec4 aModelMatRow0;layout (location = 1) in vec4 aModelMatRow1;layout (location = 2) in vec4 aModelMatRow2;layout (location = 3) in vec4 aModelMatRow3;layout (location = 4) in vec4 aColor;// Uniformslayout(set = 0, binding = 0, std140) uniform UniformBufferObject {    mat4 viewProjection;} ubo;// Outputs to fragment shaderlayout (location = 0) out vec3 FragPos;layout (location = 1) out vec3 Normal;layout (location = 2) out vec4 Color;// Cube vertices (36 vertices for 12 triangles)const vec3 cubePositions[36] = vec3[36](    // Back face    vec3(-0.5f, -0.5f, -0.5f), vec3( 0.5f, -0.5f, -0.5f), vec3( 0.5f,  0.5f, -0.5f),    vec3( 0.5f,  0.5f, -0.5f), vec3(-0.5f,  0.5f, -0.5f), vec3(-0.5f, -0.5f, -0.5f),    // Front face    vec3(-0.5f, -0.5f,  0.5f), vec3( 0.5f, -0.5f,  0.5f), vec3( 0.5f,  0.5f,  0.5f),    vec3( 0.5f,  0.5f,  0.5f), vec3(-0.5f,  0.5f,  0.5f), vec3(-0.5f, -0.5f,  0.5f),    // Left face    vec3(-0.5f,  0.5f,  0.5f), vec3(-0.5f,  0.5f, -0.5f), vec3(-0.5f, -0.5f, -0.5f),    vec3(-0.5f, -0.5f, -0.5f), vec3(-0.5f, -0.5f,  0.5f), vec3(-0.5f,  0.5f,  0.5f),    // Right face    vec3( 0.5f,  0.5f,  0.5f), vec3( 0.5f, -0.5f, -0.5f), vec3( 0.5f,  0.5f, -0.5f),    vec3( 0.5f, -0.5f, -0.5f), vec3( 0.5f,  0.5f,  0.5f), vec3( 0.5f, -0.5f,  0.5f),    // Bottom face    vec3(-0.5f, -0.5f, -0.5f), vec3( 0.5f, -0.5f, -0.5f), vec3( 0.5f, -0.5f,  0.5f),    vec3( 0.5f, -0.5f,  0.5f), vec3(-0.5f, -0.5f,  0.5f), vec3(-0.5f, -0.5f, -0.5f),    // Top face    vec3(-0.5f,  0.5f, -0.5f), vec3( 0.5f,  0.5f, -0.5f), vec3( 0.5f,  0.5f,  0.5f),    vec3( 0.5f,  0.5f,  0.5f), vec3(-0.5f,  0.5f,  0.5f), vec3(-0.5f,  0.5f, -0.5f));// Cube normals (matching vertex order)const vec3 cubeNormals[36] = vec3[36](    // Back face    vec3(0.0f, 0.0f, -1.0f), vec3(0.0f, 0.0f, -1.0f), vec3(0.0f, 0.0f, -1.0f),    vec3(0.0f, 0.0f, -1.0f), vec3(0.0f, 0.0f, -1.0f), vec3(0.0f, 0.0f, -1.0f),    // Front face    vec3(0.0f, 0.0f, 1.0f), vec3(0.0f, 0.0f, 1.0f), vec3(0.0f, 0.0f, 1.0f),    vec3(0.0f, 0.0f, 1.0f), vec3(0.0f, 0.0f, 1.0f), vec3(0.0f, 0.0f, 1.0f),    // Left face    vec3(-1.0f, 0.0f, 0.0f), vec3(-1.0f, 0.0f, 0.0f), vec3(-1.0f, 0.0f, 0.0f),    vec3(-1.0f, 0.0f, 0.0f), vec3(-1.0f, 0.0f, 0.0f), vec3(-1.0f, 0.0f, 0.0f),    // Right face    vec3(1.0f, 0.0f, 0.0f), vec3(1.0f, 0.0f, 0.0f), vec3(1.0f, 0.0f, 0.0f),    vec3(1.0f, 0.0f, 0.0f), vec3(1.0f, 0.0f, 0.0f), vec3(1.0f, 0.0f, 0.0f),    // Bottom face    vec3(0.0f, -1.0f, 0.0f), vec3(0.0f, -1.0f, 0.0f), vec3(0.0f, -1.0f, 0.0f),    vec3(0.0f, -1.0f, 0.0f), vec3(0.0f, -1.0f, 0.0f), vec3(0.0f, -1.0f, 0.0f),    // Top face    vec3(0.0f, 1.0f, 0.0f), vec3(0.0f, 1.0f, 0.0f), vec3(0.0f, 1.0f, 0.0f),    vec3(0.0f, 1.0f, 0.0f), vec3(0.0f, 1.0f, 0.0f), vec3(0.0f, 1.0f, 0.0f));void main() {    // Reconstruct the model matrix from the 4 instance attributes    mat4 model = mat4(        aModelMatRow0,        aModelMatRow1,        aModelMatRow2,        aModelMatRow3    );        // Get vertex index (gl_VertexID gives us the index within the draw call)    int idx = gl_VertexIndex;        // Get the vertex data from the constant arrays    vec3 pos = cubePositions[idx];    vec3 normal = cubeNormals[idx];        // Transform vertex position to world space    vec4 worldPos = model * vec4(pos, 1.0);        // Transform normal (using the upper 3x3 of the model matrix)    mat3 normalMatrix = mat3(transpose(inverse(model)));    vec3 worldNormal = normalize(normalMatrix * normal);        // Calculate final position in clip space    gl_Position = ubo.viewProjection * worldPos;        // Pass data to fragment shader    FragPos = worldPos.xyz;    Normal = worldNormal;    Color = aColor;}